   function toggleSkillSlot(key, slotIndex) {
     const p = gameData.player;
     if (!p) return;
     ensureEquippedSkillsArray(p);
     const idx = Number(slotIndex) === 1 ? 1 : 0;
     if (p.equippedSkills[idx] === key) {
       unequipSkillSlot(idx);
     } else {
       equipSkillToSlot(key, idx);
     }
   }
 
