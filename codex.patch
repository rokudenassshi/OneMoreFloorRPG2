   function fmtSigned(n) {
     if (typeof n !== "number" || !Number.isFinite(n) || n === 0) return "";
     return n > 0 ? `+${n}` : `${n}`;
   }
 
   function fmtStat(label, value, suffix = "") {
     const s = fmtSigned(value);
     if (!s) return "";
