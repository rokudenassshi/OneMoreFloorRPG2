   function resetStatAllocation() {
     let total = 0;
     for (let stat in gameData.player.allocatedStats) {
       total += gameData.player.allocatedStats[stat];
       gameData.player.allocatedStats[stat] = 0;
     }
     gameData.player.statPoints += total;
 
     openStatAllocation();
   }
 
