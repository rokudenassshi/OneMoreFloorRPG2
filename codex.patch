   function toggleItemLock(ev, idx) {
     if (ev) {
       ev.stopPropagation();
       ev.preventDefault();
     }
     const item = gameData.player.inventory[idx];
     if (!item) return;
 
     item.locked = !item.locked;
     log(item.locked ? "🔒 ロックした" : "🔓 ロック解除した");
     updateBagUI();
     if (typeof requestAutosave === "function") requestAutosave();
   }
 
