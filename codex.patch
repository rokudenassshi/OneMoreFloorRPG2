+    const group = skillDef?.exclusiveGroup;
+    if (group) {
+      for (const k in skills) {
+        if (k === skillKey) continue;
+        const def = skills[k];
+        if (!def || def.exclusiveGroup !== group) continue;
+        return skills[k]?.name || String(k);
+      }
+    }
+
+    return null;
+  }
